generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum CustomerType {
  INDIVIDUAL
  BUSINESS
}

enum PlanCode {
  FREE
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  PENDING_PAYMENT
  PAST_DUE
  CANCELED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  CANCELED
  FAILED
}

enum DocumentStatus {
  GENERATED
  FAILED
}

enum SalesDocumentType {
  RECEIPT
  INVOICE
}

model User {
  id                 String                   @id @default(cuid())
  email              String                   @unique
  firstName          String
  lastName           String
  passwordHash       String
  emailVerifiedAt    DateTime?
  subscriptionExempt Boolean                  @default(false)
  trialExempt        Boolean                  @default(false)
  locale             String?
  memberships        Membership[]
  verificationTokens EmailVerificationToken[]
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Organization {
  id             String          @id @default(cuid())
  name           String
  memberships    Membership[]
  templates      Template[]
  documents      Document[]
  subscription   Subscription?
  billingProfile BillingProfile?
  payments       Payment[]
  salesDocuments SalesDocument[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Membership {
  id             String       @id @default(cuid())
  role           Role         @default(MEMBER)
  userId         String
  organizationId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model BillingProfile {
  id              String       @id @default(cuid())
  organizationId  String       @unique
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerType    CustomerType
  billingEmail    String
  firstName       String?
  lastName        String?
  companyName     String?
  taxId           String?
  vatId           String?
  countryCode     String
  street          String
  buildingNumber  String
  apartmentNumber String?
  postalCode      String
  city            String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Subscription {
  id                   String             @id @default(cuid())
  organizationId       String             @unique
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan                 PlanCode           @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodEndsAt  DateTime?
  monthlyDocumentLimit Int                @default(10)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model Payment {
  id              String          @id @default(cuid())
  organizationId  String
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesDocuments  SalesDocument[]
  plan            PlanCode
  status          PaymentStatus   @default(PENDING)
  provider        String          @default("PAYU")
  providerOrderId String?         @unique
  extOrderId      String          @unique
  transferReference String?       @unique
  currency        String          @default("PLN")
  netAmount       Int
  vatAmount       Int
  grossAmount     Int
  vatRate         Int
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([organizationId])
}

model SalesDocument {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  paymentId      String?
  payment        Payment?          @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  type           SalesDocumentType
  number         String?
  fileUrl        String?
  sentAt         DateTime?
  createdAt      DateTime          @default(now())

  @@index([organizationId])
  @@index([paymentId])
}

model Template {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  content        String
  variablesJson  String       @default("[]")
  isExample      Boolean      @default(false)
  headerContent  String?
  footerContent  String?
  pageNumbers    Boolean      @default(false)
  documents      Document[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model Document {
  id              String         @id @default(cuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  templateId      String?
  template        Template?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  name            String
  status          DocumentStatus @default(GENERATED)
  payloadJson     String
  renderedContent String
  renderedHeader  String?
  renderedFooter  String?
  pageNumbers     Boolean        @default(false)
  createdAt       DateTime       @default(now())

  @@index([organizationId])
  @@index([templateId])
}
