generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String                   @id @default(cuid())
  email              String                   @unique
  passwordHash       String
  subscriptionExempt Boolean                  @default(false)
  trialExempt        Boolean                  @default(false)
  locale             String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  emailVerifiedAt    DateTime?
  firstName          String
  lastName           String
  verificationTokens EmailVerificationToken[]
  memberships        Membership[]
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Organization {
  id             String          @id @default(cuid())
  name           String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  billingProfile BillingProfile?
  documents      Document[]
  memberships    Membership[]
  payments       Payment[]
  salesDocuments SalesDocument[]
  subscription   Subscription?
  templates      Template[]
}

model Membership {
  id             String       @id @default(cuid())
  role           Role         @default(MEMBER)
  userId         String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model BillingProfile {
  id              String       @id @default(cuid())
  organizationId  String       @unique
  customerType    CustomerType
  billingEmail    String
  firstName       String?
  lastName        String?
  companyName     String?
  taxId           String?
  vatId           String?
  countryCode     String
  street          String
  buildingNumber  String
  apartmentNumber String?
  postalCode      String
  city            String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                   String             @id @default(cuid())
  organizationId       String             @unique
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodEndsAt  DateTime?
  monthlyDocumentLimit Int                @default(10)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  plan                 PlanCode           @default(FREE)
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Payment {
  id                String          @id @default(cuid())
  organizationId    String
  plan              PlanCode
  status            PaymentStatus   @default(PENDING)
  provider          String          @default("PAYU")
  providerOrderId   String?         @unique
  extOrderId        String          @unique
  currency          String          @default("PLN")
  netAmount         Int
  vatAmount         Int
  grossAmount       Int
  vatRate           Int
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  transferReference String?         @unique
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesDocuments    SalesDocument[]

  @@index([organizationId])
}

model SalesDocument {
  id             String            @id @default(cuid())
  organizationId String
  paymentId      String?
  type           SalesDocumentType
  number         String?
  fileUrl        String?
  sentAt         DateTime?
  createdAt      DateTime          @default(now())
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payment        Payment?          @relation(fields: [paymentId], references: [id])

  @@index([organizationId])
  @@index([paymentId])
}

model Template {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  description    String?
  emailSubject   String?
  content        String
  variablesJson  String       @default("[]")
  isExample      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  footerContent  String?
  headerContent  String?
  pageNumbers    Boolean      @default(false)
  documents      Document[]
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Document {
  id              String         @id @default(cuid())
  organizationId  String
  templateId      String?
  name            String
  status          DocumentStatus @default(GENERATED)
  payloadJson     String
  renderedContent String
  createdAt       DateTime       @default(now())
  pageNumbers     Boolean        @default(false)
  renderedFooter  String?
  renderedHeader  String?
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template        Template?      @relation(fields: [templateId], references: [id])

  @@index([organizationId])
  @@index([templateId])
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum CustomerType {
  INDIVIDUAL
  BUSINESS
}

enum PlanCode {
  FREE
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  PENDING_PAYMENT
  PAST_DUE
  CANCELED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  CANCELED
  FAILED
}

enum DocumentStatus {
  GENERATED
  FAILED
}

enum SalesDocumentType {
  RECEIPT
  INVOICE
}
