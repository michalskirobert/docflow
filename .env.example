# PostgreSQL (Neon recommended for local testing)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Use a long random secret in production (openssl rand -base64 48)
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
CAPTCHA_SECRET="replace-with-another-long-random-secret-at-least-32-characters"

NEXT_PUBLIC_APP_NAME="DocFlow"
NEXT_PUBLIC_COMPANY_NAME="NurByte"
NEXT_PUBLIC_COMPANY_URL="https://nurbyte.com"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

DEFAULT_TRIAL_DAYS="30"
DEFAULT_MONTHLY_DOCUMENT_LIMIT="100"
